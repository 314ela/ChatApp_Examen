<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla del Chat CustomListView con 20 mensajes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="vertical">

    <!-- Barra superior con el contacto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/azul_principal"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/ivRegresarChat"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/boton_regresar"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/blanco" />

        <TextView
            android:id="@+id/tvInicialChat"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/bg_circulo_blanco"
            android:gravity="center"
            android:textColor="@color/azul_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreChat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/blanco"
                android:textSize="17sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_en_linea" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/chat_en_linea"
                    android:textColor="@color/blanco"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/chat_boton_opciones"
            android:src="@drawable/ic_puntitos"
            app:tint="@color/blanco" />
    </LinearLayout>

    <!-- Lista de mensajes -->
    <ListView
        android:id="@+id/lvMensajes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/gris_fondo"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:padding="8dp"
        android:stackFromBottom="false"
        android:transcriptMode="alwaysScroll" />

    <!-- Barra para escribir -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blanco"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/chat_boton_adjuntar"
            android:src="@drawable/ic_clip"
            app:tint="@color/texto_secundario" />

        <EditText
            android:id="@+id/etMensaje"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_campo"
            android:hint="@string/chat_hint_mensaje"
            android:inputType="textCapSentences"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/ivEnviar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_azul"
            android:contentDescription="@string/chat_boton_enviar"
            android:padding="10dp"
            android:src="@drawable/ic_enviar"
            app:tint="@color/blanco" />
    </LinearLayout>

</LinearLayout>
