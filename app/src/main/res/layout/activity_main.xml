<?xml version="1.0" encoding="utf-8"?>
<!-- Login -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="vertical">

    <!-- Cuadro azul del logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.38"
        android:background="@color/azul_principal"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/icono"
            android:src="@drawable/ic_chat"
            app:tint="@color/blanco" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name"
            android:textColor="@color/blanco"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/login_subtitulo"
            android:textColor="@color/blanco"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Formulario -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.62"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Datos del usuario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/icono"
                android:src="@drawable/ic_mail"
                app:tint="@color/texto_secundario" />

            <EditText
                android:id="@+id/etUsuario"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/login_hint_usuario"
                android:inputType="textEmailAddress"
                android:paddingStart="12dp"
                android:singleLine="true"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Contraseña -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_campo"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/icono"
                android:src="@drawable/ic_lock"
                app:tint="@color/texto_secundario" />

            <EditText
                android:id="@+id/etClave"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/login_hint_clave"
                android:inputType="textPassword"
                android:paddingStart="12dp"
                android:singleLine="true"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/ivVerClave"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@string/ver_clave"
                android:src="@drawable/ic_ojito"
                app:tint="@color/texto_secundario" />
        </LinearLayout>

        <Button
            android:id="@+id/btnIniciarSesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_boton_azul"
            android:text="@string/login_boton_iniciar"
            android:textAllCaps="false"
            android:textColor="@color/blanco"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbGuardarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:checked="true"
            android:text="@string/login_guardar_sesion" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/login_o"
            android:textColor="@color/texto_secundario" />

        <Button
            android:id="@+id/btnCrearCuenta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_boton_borde"
            android:text="@string/login_crear_cuenta"
            android:textAllCaps="false"
            android:textColor="@color/azul_principal"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvOlvidoClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/login_olvido_clave"
            android:textColor="@color/azul_principal"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
